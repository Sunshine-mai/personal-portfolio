#!/bin/sh
# 推送前门禁 —— 未通过 utils/verify.mjs 的改动不应进入远端。
#
# 安装：node utils/setup.mjs    （等价于 git config core.hooksPath .githooks）
# 跳过：git push --no-verify    —— 跳过即表示自行承担风险，不要养成习惯。
#
# 钩子自己判断本次推送动了什么，不需要人记参数：
#   触及 project/backend/  → 连后端测试一起跑
#   只动前端或文档          → 秘密扫描 + 构建 + 浏览器验收
#
# 放在 pre-push 而不是 pre-commit：提交是廉价的本地动作，推送才是会把问题
# 带给别人的动作。每次提交都跑一遍完整门禁会让人学会 --no-verify，那门禁就废了。
set -u

zero=0000000000000000000000000000000000000000
refs=0
run_backend=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  refs=$((refs + 1))
  if [ "$remote_sha" = "$zero" ]; then
    # 远端还没有这个分支，按全部跟踪文件判定
    if git ls-files | grep -q '^project/backend/'; then run_backend=1; fi
  else
    if git diff --name-only "$remote_sha..$local_sha" | grep -q '^project/backend/'; then
      run_backend=1
    fi
  fi
done

# 解析不到任何引用时按最严处理：脚本自身出问题不应该变成放行。
if [ "$refs" -eq 0 ]; then run_backend=1; fi

if [ "$run_backend" = "1" ]; then
  echo "==> 推送前门禁：本次涉及后端，包含后端测试"
  exec node utils/verify.mjs
else
  echo "==> 推送前门禁：本次未涉及后端"
  exec node utils/verify.mjs --no-backend
fi
